<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مترجم الألعاب الفوري"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="الحالة: بانتظار التفعيل"
        android:textColor="#BBBBBB"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etEnglishText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E1E1E"
        android:hint="اكتب أو الصق نص اللعبة الإنجليزي هنا..."
        android:inputType="textMultiLine"
        android:minLines="3"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777" />

    <Button
        android:id="@+id/btnOverlayPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2E7D32"
        android:text="1. صلاحية العرض فوق التطبيقات"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#1565C0"
        android:text="2. تفعيل خدمة تسهيل الاستخدام (بديل النظام)"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnShowTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#C62828"
        android:text="3. ترجمة وعرض فوق الشاشة"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnHideOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#424242"
        android:text="إخفاء نافذة الترجمة"
        android:textColor="#FFFFFF" />

</LinearLayout>
